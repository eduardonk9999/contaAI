{
  "info": {
    "name": "Conta+ Backend MVP",
    "description": "Rotas locais do backend Conta+. Execute na ordem indicada.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3333" },
    { "key": "product_id", "value": "" },
    { "key": "idempotency_key", "value": "11111111-1111-4111-8111-222222222222" }
  ],
  "item": [
    {
      "name": "1. Health",
      "request": { "method": "GET", "url": "{{base_url}}/health" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('API online', () => pm.response.to.have.status(200));"] } }]
    },
    {
      "name": "2. Listar produtos",
      "request": { "method": "GET", "url": "{{base_url}}/v1/products" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Produtos retornados', () => pm.expect(pm.response.json().data.length).to.be.above(0));", "const camiseta = pm.response.json().data.find(p => p.name.toLowerCase().includes('camiseta'));", "if (camiseta) pm.collectionVariables.set('product_id', camiseta.id);"] } }]
    },
    {
      "name": "3. Criar produto",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Caneca Conta+ {{$timestamp}}\",\n  \"cost_price_cents\": 1500,\n  \"sale_price_cents\": 3000,\n  \"stock_quantity\": 10,\n  \"stock_unit\": \"UNIT\",\n  \"min_stock_quantity\": 2\n}" },
        "url": "{{base_url}}/v1/products"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Produto criado', () => pm.response.to.have.status(201));"] } }]
    },
    {
      "name": "4. Preview por texto",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"text\": \"vendi duas camisetas por cinquenta reais cada\"\n}" },
        "url": "{{base_url}}/v1/sales/preview"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Preview calculado', () => { const d = pm.response.json().data; pm.expect(d.total_amount_cents).to.eql(10000); pm.expect(d.gross_profit_cents).to.eql(4000); pm.expect(d.margin_percent).to.eql(40); });", "const item = pm.response.json().data.items[0];", "pm.collectionVariables.set('product_id', item.product_id);"] } }]
    },
    {
      "name": "5. Preview manual",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"items\": [{\n    \"product_id\": \"{{product_id}}\",\n    \"quantity\": 2,\n    \"unit_price_cents\": 5000\n  }],\n  \"source\": \"MANUAL\"\n}" },
        "url": "{{base_url}}/v1/sales/preview"
      }
    },
    {
      "name": "6. Confirmar venda",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"items\": [{\n    \"product_id\": \"{{product_id}}\",\n    \"quantity\": 2,\n    \"unit_price_cents\": 5000\n  }],\n  \"source\": \"TEXT\",\n  \"original_input\": \"vendi duas camisetas por cinquenta reais cada\",\n  \"idempotency_key\": \"{{$guid}}\"\n}" },
        "url": "{{base_url}}/v1/sales/confirm"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Venda confirmada', () => pm.response.to.have.status(201));"] } }]
    },
    {
      "name": "7. Listar transações",
      "request": { "method": "GET", "url": "{{base_url}}/v1/transactions" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Histórico retornado', () => pm.response.to.have.status(200));"] } }]
    },
    {
      "name": "8. Dashboard",
      "request": { "method": "GET", "url": "{{base_url}}/v1/dashboard/summary" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Dashboard retornado', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data).to.have.property('gross_profit_cents'); });"] } }]
    }
  ]
}
